# Copy this file to .env for local development (never commit the real .env)

# No API keys needed for maps or nearby shops -- the app uses Leaflet +
# OpenStreetMap tiles (free, no key) and the Overpass API (free, no key)
# for both the map and the "fertilizer shops near me" feature.

# Set to "true" to enable the original FAISS + GPT-2 pipeline.
# Leave "false" for fast, lightweight rule-based advice (recommended
# for free-tier hosting).
ENABLE_AI_ADVICE=false

# Flask dev server only -- leave false/unset in production
FLASK_DEBUG=false
